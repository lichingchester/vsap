.DS_Store
node_modules
/dist

# Astro
.astro/

# Obsidian (per-user UI state; shared vault config stays tracked)
tskr-ui-vault/.obsidian/workspace*.json
tskr-ui-vault/.obsidian/cache

# local env files
.env.local
.env.*.local

# Claude Code / Impeccable per-developer settings (skill files stay tracked)
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/*.cache.json

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vitepress
docs/.vitepress/dist
docs/.vitepress/cache
# nested impeccable per-dev cache (from component moves)
**/.impeccable/

# Sandboxes (dev-only verification harness, ADR-0017) — build output & test
# artifacts. node_modules is already covered by the global rule above.
sandboxes/**/dist
sandboxes/smoke/test-results
sandboxes/smoke/playwright-report
