---
/*
 * DemoMainD — main content for Direction D (the confirmed synthesis).
 *
 * Home is deliberately simple: headline + description + CTA + one preview block
 * (live demo + code). The detail surface adds an interactive **props controls**
 * panel: tweaking colours / angle / speed updates the live gradient in place
 * (the same idea as the real flagship playground, ADR-0007). Throwaway demo.
 */
import gradientTextMeta from "../../snippets/text-animations/gradient-text/meta";

import vueTwSrc from "../../snippets/text-animations/gradient-text/vue-tailwind/GradientText.vue?raw";
import vueCssSrc from "../../snippets/text-animations/gradient-text/vue-css/GradientText.vue?raw";
import reactTwSrc from "../../snippets/text-animations/gradient-text/react-tailwind/GradientText.tsx?raw";
import htmlSrc from "../../snippets/text-animations/gradient-text/html/gradient-text.html?raw";

const detail = gradientTextMeta;
const codeById: Record<string, string> = {
  "vue-tailwind": vueTwSrc,
  "vue-css": vueCssSrc,
  "react-tailwind": reactTwSrc,
  html: htmlSrc,
};
const tabs = detail.variants.filter((v) => codeById[v.id]);
const firstPrereq = tabs[0]?.prerequisites?.[0];
---

<!-- ============ SURFACE 1: SIMPLE HOME ============ -->
<section class="d-hero">
  <span class="d-eyebrow">copy · paste · ship</span>
  <h1>Components you <em>own</em>, not install.</h1>
  <p>
    A copy-paste collection of components, effects, and layouts. No CLI, no
    package. The source goes straight into your project.
  </p>
  <div class="d-cta">
    <a class="d-btn d-btn--primary" href="#detail">Get started</a>
    <a class="d-btn d-btn--ghost" href="https://github.com/lichingchester/vsap"
      >GitHub</a
    >
  </div>
</section>

<!-- Preview block: demo + code (the whole homepage, kept simple) -->
<div class="d-stage">
  <span class="d-gradient-text">The quick brown fox</span>
</div>
<div class="d-source" data-source>
  <div class="d-tabbar" role="tablist">
    {
      tabs.map((v, i) => (
        <button
          class="d-tab"
          role="tab"
          data-tab={v.id}
          aria-selected={i === 0 ? "true" : "false"}
        >
          {v.label}
        </button>
      ))
    }
    <button class="d-copy" data-copy>Copy</button>
  </div>
  {
    tabs.map((v, i) => (
      <pre class="d-code" data-code={v.id} hidden={i !== 0}><code>{codeById[v.id]}</code></pre>
    ))
  }
</div>

<!-- ============ SURFACE 2: DETAIL WITH PROPS CONTROLS ============ -->
<div class="d-divider" id="detail">
  <span>↓ snippet detail · live props controls</span>
</div>

<article class="d-detail">
  <p class="d-detail__kind">{detail.kind} · {detail.category}</p>
  <h2>{detail.title}</h2>
  <p class="d-detail__desc">{detail.description}</p>

  <!-- Live preview the controls drive -->
  <div class="d-stage">
    <span class="d-gradient-text" id="d-grad">The quick brown fox</span>
  </div>

  <!-- Props field controls -->
  <div class="d-controls" data-controls>
    <p class="d-controls__title">Props</p>

    <div class="d-control">
      <span class="d-control__label"><code>colors</code></span>
      <div class="d-control__field d-swatches">
        <input class="d-swatch" type="color" data-c value="#5eead4" aria-label="color 1" />
        <input class="d-swatch" type="color" data-c value="#38bdf8" aria-label="color 2" />
        <input class="d-swatch" type="color" data-c value="#818cf8" aria-label="color 3" />
      </div>
    </div>

    <div class="d-control">
      <span class="d-control__label"><code>direction</code></span>
      <div class="d-control__field">
        <input type="range" id="d-angle" min="0" max="360" value="100" />
        <span class="d-control__val" data-angle-val>100°</span>
      </div>
    </div>

    <div class="d-control">
      <span class="d-control__label"><code>speed</code></span>
      <div class="d-control__field">
        <input type="range" id="d-speed" min="1" max="12" step="0.5" value="5" />
        <span class="d-control__val" data-speed-val>5s</span>
      </div>
    </div>
  </div>

  <p class="d-section-label d-source-label">Source</p>
  <div class="d-source" data-source>
    <div class="d-tabbar" role="tablist">
      {
        tabs.map((v, i) => (
          <button
            class="d-tab"
            role="tab"
            data-tab={v.id}
            aria-selected={i === 0 ? "true" : "false"}
          >
            {v.label}
          </button>
        ))
      }
      <button class="d-copy" data-copy>Copy</button>
    </div>
    {
      firstPrereq && (
        <div class="d-prereq">
          <strong>Before you paste:</strong>{" "}
          {firstPrereq.npm && <code>npm i {firstPrereq.npm}</code>}
          {firstPrereq.note}
        </div>
      )
    }
    {
      tabs.map((v, i) => (
        <pre class="d-code" data-code={v.id} hidden={i !== 0}><code>{codeById[v.id]}</code></pre>
      ))
    }
  </div>
</article>

<footer class="d-foot">tskr/ui · Direction D (synthesis) demo</footer>

<script is:inline>
  // Live props controls → drive the gradient preview.
  const grad = document.getElementById("d-grad");
  const panel = document.querySelector("[data-controls]");
  if (grad && panel) {
    const colors = [...panel.querySelectorAll("[data-c]")];
    const angle = panel.querySelector("#d-angle");
    const speed = panel.querySelector("#d-speed");
    const angleVal = panel.querySelector("[data-angle-val]");
    const speedVal = panel.querySelector("[data-speed-val]");
    const apply = () => {
      const cs = colors.map((c) => c.value);
      const stops = [...cs, cs[1], cs[0]].join(", ");
      grad.style.background = `linear-gradient(${angle.value}deg, ${stops})`;
      grad.style.backgroundSize = "200% auto";
      grad.style.webkitBackgroundClip = "text";
      grad.style.backgroundClip = "text";
      grad.style.color = "transparent";
      grad.style.animationDuration = `${speed.value}s`;
      angleVal.textContent = `${angle.value}°`;
      speedVal.textContent = `${speed.value}s`;
    };
    [...colors, angle, speed].forEach((el) =>
      el.addEventListener("input", apply),
    );
    apply();
  }

  // Tabs + copy for every source block on the page.
  document.querySelectorAll("[data-source]").forEach((block) => {
    const tabs = [...block.querySelectorAll("[data-tab]")];
    const panes = [...block.querySelectorAll("[data-code]")];
    const copyBtn = block.querySelector("[data-copy]");
    const select = (id) => {
      tabs.forEach((t) =>
        t.setAttribute("aria-selected", String(t.dataset.tab === id)),
      );
      panes.forEach((p) => (p.hidden = p.dataset.code !== id));
    };
    tabs.forEach((t) => t.addEventListener("click", () => select(t.dataset.tab)));
    copyBtn?.addEventListener("click", async () => {
      const active = panes.find((p) => !p.hidden);
      if (!active) return;
      await navigator.clipboard.writeText(active.textContent || "");
      copyBtn.textContent = "Copied!";
      setTimeout(() => (copyBtn.textContent = "Copy"), 1500);
    });
  });
</script>
