---
/*
 * DetailShell — terminal-styled detail shell (ADR-0008): full-width header with
 * a `detail:` arrangement switcher, a monospace snippet index sidebar (matching
 * the confirmed Terminal · Masthead homepage), and a contained main column.
 * Throwaway scaffolding.
 */
import "../../styles/global.css";
import "../../styles/demos.css";
import { groupedCatalog } from "./catalog";

interface Props {
  current: string;
  active?: string;
}
const { current, active } = Astro.props;

const options = [
  { id: "stacked", label: "Stacked", href: "/demos/detail/stacked" },
  { id: "workbench", label: "Workbench", href: "/demos/detail/workbench" },
  { id: "panels", label: "Panels", href: "/demos/detail/panels" },
];
const here = options.find((o) => o.id === current)?.href ?? "/demos/detail/stacked";
const nav = groupedCatalog();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Detail · {current} — tskr/ui demo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="d-root" data-direction="e">
    <div class="d-app">
      <header class="d-header">
        <a class="d-brand" href="/demos/home">tskr<span>/ui</span></a>
        <div class="d-header__right">
          <nav class="d-dirswitch" aria-label="Detail arrangement">
            <span>detail</span>
            {
              options.map((o) => (
                <a href={o.href} aria-current={o.id === current ? "true" : "false"}>
                  {o.label}
                </a>
              ))
            }
          </nav>
          <a class="d-headerlink" href="https://github.com/lichingchester/vsap">GitHub</a>
        </div>
      </header>

      <div class="d-body">
        <aside class="d-sidebar" aria-label="Snippets">
          {
            nav.map((group) => (
              <div class="d-sidebar__group">
                <p class="d-sidebar__cat">{group.label}</p>
                {group.items.map((it) =>
                  it.real ? (
                    <a
                      class="dt-link"
                      href={here}
                      aria-current={it.name === active ? "true" : "false"}
                    >
                      <em>{group.category}/</em>
                      {it.name}
                    </a>
                  ) : (
                    <span class="dt-link" aria-disabled="true">
                      <em>{group.category}/</em>
                      {it.name}
                    </span>
                  ),
                )}
              </div>
            ))
          }
        </aside>

        <main class="d-main">
          <div class="d-container">
            <slot />
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
