---
/* OnThisPage — right-hand TOC with scroll-spy over `.s-section` elements. */
interface Item {
  id: string;
  label: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<nav class="docs-toc" aria-label="On this page">
  <p class="docs-toc__title">On this page</p>
  {items.map((t) => <a href={`#${t.id}`} data-toc={t.id}>{t.label}</a>)}
</nav>

<script is:inline>
  const links = new Map(
    [...document.querySelectorAll("[data-toc]")].map((a) => [a.dataset.toc, a]),
  );
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          links.forEach((a) => a.setAttribute("aria-current", "false"));
          links.get(e.target.id)?.setAttribute("aria-current", "true");
        }
      });
    },
    { rootMargin: "-20% 0px -70% 0px" },
  );
  document.querySelectorAll(".s-section").forEach((s) => obs.observe(s));
</script>
