---
/* ApiTable — renders a snippet's props (from meta.ts) as the API reference. */
import type { PropDoc } from "../snippets/types";

interface Props {
  props: PropDoc[];
}
const { props } = Astro.props;
---

<table class="api">
  <thead>
    <tr>
      <th>Prop</th>
      <th>Type</th>
      <th>Default</th>
      <th>Description</th>
    </tr>
  </thead>
  <tbody>
    {
      props.map((p) => (
        <tr>
          <td class="api__name">{p.name}</td>
          <td class="api__type">{p.type}</td>
          <td class="api__def">{p.default ?? "—"}</td>
          <td>{p.description}</td>
        </tr>
      ))
    }
  </tbody>
</table>
