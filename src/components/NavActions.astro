---
/*
 * NavActions — the right-hand icon cluster shared by every nav (home, docs
 * header, /design, /demo): Design + GitHub as icon links, then the theme toggle.
 * Docs-only site chrome, never copied. Icon-only, so each link carries an
 * aria-label + title; the current page is marked with aria-current for the
 * accent-text highlight (see `.s-navicon` in site.css).
 */
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** Which page is active, for aria-current on the matching icon. */
  current?: "design";
}
const { current } = Astro.props;
---

<a
  class="s-navicon"
  href="/design"
  aria-label="Design system"
  title="Design system"
  aria-current={current === "design" ? "page" : undefined}
>
  <svg
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
    <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
    <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
    <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
    <path
      d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2Z"
    ></path>
  </svg>
</a>

<a
  class="s-navicon"
  href="https://github.com/lichingchester/tskr-ui"
  aria-label="GitHub repository"
  title="GitHub"
>
  <svg
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path
      d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
    ></path>
    <path d="M9 18c-4.51 2-5-2-7-2"></path>
  </svg>
</a>

<ThemeToggle />
