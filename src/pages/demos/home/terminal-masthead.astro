---
/*
 * Terminal homepage — "Masthead": the terminal aesthetic with an enriched
 * header — CTA buttons, a mono stats row, and "Why tskr/ui" as # comment lines,
 * with the snippet index below. (ADR-0008)
 */
import "../../../styles/global.css";
import "../../../styles/demos.css";
import { catalog, groupedCatalog } from "../../../components/demos/catalog";
import TermNav from "../../../components/demos/TermNav.astro";

const detailHref = "/demos/e/detail";
const groups = groupedCatalog();
const total = catalog.length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Homepage · Terminal Masthead — tskr/ui demo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-direction="e">
    <div class="e-shell">
      <TermNav current="masthead" />
      <div class="ht-wrap">
        <header class="ht-head">
          <h1 class="ht-word">tskr<span>/ui</span></h1>
          <p class="ht-tag">
            A copy-paste collection of components, effects, and layouts. Pick one,
            copy the source, paste it in. No CLI, no package.
          </p>

          <div class="ht-cta">
            <a class="d-btn d-btn--primary" href={detailHref}>Browse snippets</a>
            <a class="d-btn d-btn--ghost" href="https://github.com/lichingchester/vsap">GitHub</a>
          </div>

          <div class="ht-stats">
            <span><b>{total}</b> snippets</span>
            <span><b>{groups.length}</b> categories</span>
            <span><b>vue · react · html</b></span>
            <span><b>tailwind / css</b></span>
          </div>

          <div class="ht-why">
            <p class="ht-why__row"><b># </b><strong>copy, don't install</strong> — the source lives in your repo, no version churn</p>
            <p class="ht-why__row"><b># </b><strong>any stack</strong> — Vue, React, or plain HTML; Tailwind or native CSS</p>
            <p class="ht-why__row"><b># </b><strong>prerequisites, not magic</strong> — each snippet states exactly what it needs</p>
          </div>
        </header>

        <div class="ht-index">
          {
            groups.map((g) => (
              <section>
                <p class="ht-cat">{g.label}</p>
                {g.items.map((s) => (
                  <a class="ht-item" href={detailHref}>
                    <span class="ht-item__path"><em>{g.category}/</em>{s.name}</span>
                    <span class="ht-item__kind">{s.kind}</span>
                  </a>
                ))}
              </section>
            ))
          }
        </div>

        <footer class="e-foot">tskr/ui · homepage candidate · terminal masthead</footer>
      </div>
    </div>
  </body>
</html>
