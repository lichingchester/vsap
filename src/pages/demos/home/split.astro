---
/*
 * Homepage candidate — "Split": asymmetric editorial. Left = headline + copy +
 * CTA; right = a live snippet list panel. Left-aligned, not centered. No
 * sidebar. (ADR-0008)
 */
import "../../../styles/global.css";
import "../../../styles/demos.css";
import { catalog } from "../../../components/demos/catalog";
import HomeNav from "../../../components/demos/HomeNav.astro";

const detailHref = "/demos/e/detail";
const listed = catalog.slice(0, 8);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Homepage · Split — tskr/ui demo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-direction="e">
    <div class="e-shell">
      <HomeNav current="split" />
      <div class="e-wrap">
        <section class="hs-hero">
          <div class="hs-copy">
            <span class="e-eyebrow">the copy-paste collection</span>
            <h1>Components you <em>own</em>, not install.</h1>
            <p>
              Copy the source straight into your project. No CLI, no package, no
              lock-in. Vue, React, or plain HTML.
            </p>
            <div class="e-cta">
              <a class="d-btn d-btn--primary" href={detailHref}>Browse snippets</a>
              <a class="d-btn d-btn--ghost" href="https://github.com/lichingchester/vsap">GitHub</a>
            </div>
            <div class="hs-stat">
              <span><b>{catalog.length}</b> snippets</span>
              <span><b>3</b> frameworks</span>
              <span><b>0</b> dependencies on us</span>
            </div>
          </div>

          <div class="hs-list">
            {
              listed.map((s) => (
                <a class="hs-row" href={detailHref}>
                  <span class="hs-row__name">{s.title}</span>
                  <span class="hs-row__meta">
                    <span class="hs-row__kind">{s.kind}</span>
                    <span class="hs-row__arrow">→</span>
                  </span>
                </a>
              ))
            }
          </div>
        </section>

        <footer class="e-foot">tskr/ui · homepage candidate · split</footer>
      </div>
    </div>
  </body>
</html>
