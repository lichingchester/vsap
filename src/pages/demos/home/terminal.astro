---
/*
 * Homepage candidate — "Terminal": minimal typographic index. Big wordmark, a
 * one-line tagline, a faux search, and a monospace directory of every snippet.
 * Dev-tool / README feel. No sidebar. (ADR-0008)
 */
import "../../../styles/global.css";
import "../../../styles/demos.css";
import { groupedCatalog } from "../../../components/demos/catalog";
import HomeNav from "../../../components/demos/HomeNav.astro";

const detailHref = "/demos/e/detail";
const groups = groupedCatalog();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Homepage · Terminal — tskr/ui demo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-direction="e">
    <div class="e-shell">
      <HomeNav current="terminal" />
      <div class="ht-wrap">
        <header class="ht-head">
          <h1 class="ht-word">tskr<span>/ui</span></h1>
          <p class="ht-tag">
            A copy-paste collection of components, effects, and layouts. Pick one,
            copy the source, paste it in. No CLI, no package.
          </p>
          <div class="ht-search">
            <b>›</b> search {groups.reduce((n, g) => n + g.items.length, 0)} snippets…
          </div>
        </header>

        <div class="ht-index">
          {
            groups.map((g) => (
              <section>
                <p class="ht-cat">{g.label}</p>
                {g.items.map((s) => (
                  <a class="ht-item" href={detailHref}>
                    <span class="ht-item__path">
                      <em>{g.category}/</em>
                      {s.name}
                    </span>
                    <span class="ht-item__kind">{s.kind}</span>
                  </a>
                ))}
              </section>
            ))
          }
        </div>

        <footer class="e-foot">tskr/ui · homepage candidate · terminal</footer>
      </div>
    </div>
  </body>
</html>
