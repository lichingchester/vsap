---
/*
 * THROWAWAY (detail-page /demos harness). Round 2: the STACKED layout won, so
 * these three explore stacked variations — section design, right-sidebar (TOC),
 * headings, and the code block. Deleted on promotion.
 */
import Layout from "../../layouts/Layout.astro";

const demos = [
  {
    id: "s1",
    name: "Ledger",
    blurb:
      "Numbered, full-width ruled section headings (01 Preview); left-border TOC reading rail; minimal code block; variant selector in the Source heading row.",
  },
  {
    id: "s2",
    name: "Slab",
    blurb:
      "Uppercase label-tag section headings + a kind badge on the title; boxed dot-marker TOC; the variant selector fused into the code block's top toolbar.",
  },
  {
    id: "s3",
    name: "Console",
    blurb:
      "Sticky mini-headers with an accent tick; a scroll-progress TOC rail; an IDE code block with line numbers + a wrap toggle and a sticky code toolbar.",
  },
];
---

<Layout title="Detail-page demos">
  <main class="home">
    <div class="home-head">
      <h1 class="home-word">stacked<span>/variations</span></h1>
      <p class="home-tag">
        Round 2 — the stacked layout won; these three explore it further:
        section design, the right-sidebar TOC, headings, and the code block. All
        share the Install · Source · Usage copy model, live props→code, and Shiki
        highlighting. The variant selector now lives only in the header and at
        the code block — not the page head. Try the header toggle and the props
        controls; Usage updates as you edit.
      </p>
    </div>

    <div class="home-index">
      <p class="home-cat">layouts</p>
      {
        demos.map((d) => (
          <a class="home-item" href={`/demos/detail/${d.id}`}>
            <span class="home-item__path">
              <em>{d.id}/</em>
              {d.name}
            </span>
            <span class="home-item__kind">open →</span>
          </a>
        ))
      }
      <p class="home-cat">snippets in each demo</p>
      <p class="home-why">
        <span>gradient-text — flagship effect with live controls</span><br />
        <span>link-tag — utility, static preview, native variants</span>
      </p>
    </div>
  </main>
</Layout>
