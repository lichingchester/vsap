---
/*
 * /demos index (ADR-0008) — entry point for the design-direction exploration.
 * Throwaway scaffolding; removed when a direction is promoted.
 */
import DemoLayout from "../../layouts/DemoLayout.astro";

const directions = [
  {
    id: "b",
    href: "/demos/b",
    title: "Direction B · amber on charcoal",
    note: "React Bits' UX, our own identity. Warm accent, dark canvas, tight radii, calm motion.",
  },
  {
    id: "c",
    href: "/demos/c",
    title: "Direction C · light Swiss, crimson",
    note: "Deliberate contrast. Light paper, crimson accent, sharp corners, dense, snappy. Preview stage stays dark.",
  },
];
---

<DemoLayout title="Design directions" direction="b">
  <section class="d-hero" style="padding-bottom:2rem">
    <span class="d-eyebrow">design system · exploration</span>
    <h1>Design directions.</h1>
    <p>
      Each direction is one token set rendered through the same shell, judged on
      both the home and a snippet detail page. Pick the winner; its tokens get
      promoted into the real site.
    </p>
  </section>

  <p class="d-section-label">Directions</p>
  <div class="d-grid" style="grid-template-columns:1fr">
    {
      directions.map((d) => (
        <a class="d-card" href={d.href}>
          <span class="d-card__kind">direction {d.id}</span>
          <h2 class="d-card__title">{d.title}</h2>
          <p class="d-card__desc">{d.note}</p>
        </a>
      ))
    }
  </div>
</DemoLayout>
