---
/*
 * Direction C demo (ADR-0008) — gallery / "lab".
 * A structurally different design from B (escape hatch): no sidebar, a top
 * category-filter bar, and an edge-to-edge bento gallery where the previews are
 * the navigation. Self-contained shell (does not use DemoLayout). Throwaway.
 */
import "../../styles/global.css";
import "../../styles/demos.css";
import { catalog, groupedCatalog } from "../../components/demos/catalog";
import gradientTextMeta from "../../snippets/text-animations/gradient-text/meta";

import vueTwSrc from "../../snippets/text-animations/gradient-text/vue-tailwind/GradientText.vue?raw";
import vueCssSrc from "../../snippets/text-animations/gradient-text/vue-css/GradientText.vue?raw";
import reactTwSrc from "../../snippets/text-animations/gradient-text/react-tailwind/GradientText.tsx?raw";
import htmlSrc from "../../snippets/text-animations/gradient-text/html/gradient-text.html?raw";

const groups = groupedCatalog();
const detail = gradientTextMeta;
const codeById: Record<string, string> = {
  "vue-tailwind": vueTwSrc,
  "vue-css": vueCssSrc,
  "react-tailwind": reactTwSrc,
  html: htmlSrc,
};
const tabs = detail.variants.filter((v) => codeById[v.id]);
const firstPrereq = tabs[0]?.prerequisites?.[0];

// Featured live tile first (the real gradient-text), then the rest.
const featured = catalog.find((s) => s.name === "gradient-text")!;
const rest = catalog.filter((s) => s.name !== "gradient-text");

// Sprinkle bento spans for visual rhythm.
const spanClass = (i: number) =>
  i % 7 === 2 ? " c-tile--wide" : i % 9 === 5 ? " c-tile--tall" : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Direction C — tskr/ui demo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-direction="c">
    <div class="c-shell">
      <!-- Top bar: brand + dir switch + filter pills -->
      <div class="c-top">
        <div class="c-top__bar">
          <a class="c-brand" href="/demos">tskr<span>/ui</span> lab</a>
          <div class="c-top__right">
            <nav class="d-dirswitch" aria-label="Design direction">
              <span>dir</span>
              <a href="/demos/b" aria-current="false">B</a>
              <a href="/demos/c" aria-current="true">C</a>
            </nav>
            <a class="c-link" href="https://github.com/lichingchester/vsap"
              >GitHub</a
            >
          </div>
        </div>
        <div class="c-filter" role="group" aria-label="Filter by category">
          <button class="c-pill" data-cat="all" aria-pressed="true">All</button>
          {
            groups.map((g) => (
              <button class="c-pill" data-cat={g.category} aria-pressed="false">
                {g.label}
              </button>
            ))
          }
        </div>
      </div>

      <main class="c-main">
        <p class="c-eyebrow">the collection</p>
        <h1 class="c-title">Browse the lab.</h1>
        <p class="c-lead">
          Every snippet, previewed live. Filter by category, click a tile to
          open it. The previews are the navigation.
        </p>

        <p class="c-count">{catalog.length} snippets</p>

        <!-- ============ SURFACE 1: GALLERY ============ -->
        <div class="c-bento" data-gallery>
          <!-- Featured live tile -->
          <a
            class="c-tile c-tile--wide c-tile--tall"
            href="#detail"
            data-category={featured.category}
          >
            <div class="c-tile__art c-tile__art--live">
              <span class="d-gradient-text">Gradient Text</span>
            </div>
            <div class="c-tile__bar">
              <span class="c-tile__name">{featured.title}</span>
              <span class="c-tile__live">live</span>
            </div>
          </a>

          {
            rest.map((s, i) => (
              <a
                class={"c-tile" + spanClass(i)}
                href="#detail"
                data-category={s.category}
              >
                <div class={"c-tile__art c-art-" + (i % 6)} />
                <div class="c-tile__bar">
                  <span class="c-tile__name">{s.title}</span>
                  <span class="c-tile__kind">{s.kind}</span>
                </div>
              </a>
            ))
          }
        </div>

        <!-- ============ SURFACE 2: DETAIL ============ -->
        <section class="c-detail" id="detail">
          <div class="c-hero-preview">
            <span class="d-gradient-text">The quick brown fox</span>
          </div>

          <div class="c-detail__head">
            <p class="c-eyebrow">{detail.kind} · {detail.category}</p>
            <h2 class="c-title">{detail.title}</h2>
          </div>

          <div class="c-cols">
            <div>
              <p class="d-detail__desc" style="margin-top:0">
                {detail.description}
              </p>
            </div>

            <div class="d-source" data-source>
              <div class="d-tabbar" role="tablist">
                {
                  tabs.map((v, i) => (
                    <button
                      class="d-tab"
                      role="tab"
                      data-tab={v.id}
                      aria-selected={i === 0 ? "true" : "false"}
                    >
                      {v.label}
                    </button>
                  ))
                }
                <button class="d-copy" data-copy>Copy</button>
              </div>
              {
                firstPrereq && (
                  <div class="d-prereq">
                    <strong>Before you paste:</strong>{" "}
                    {firstPrereq.npm && <code>npm i {firstPrereq.npm}</code>}
                    {firstPrereq.note}
                  </div>
                )
              }
              {
                tabs.map((v, i) => (
                  <pre class="d-code" data-code={v.id} hidden={i !== 0}><code>{codeById[v.id]}</code></pre>
                ))
              }
            </div>
          </div>
        </section>

        <footer class="c-foot">tskr/ui · Direction C (gallery) demo</footer>
      </main>
    </div>

    <script is:inline>
      // Category filter
      const gallery = document.querySelector("[data-gallery]");
      const pills = [...document.querySelectorAll(".c-pill")];
      pills.forEach((pill) =>
        pill.addEventListener("click", () => {
          const cat = pill.dataset.cat;
          pills.forEach((p) =>
            p.setAttribute("aria-pressed", String(p === pill)),
          );
          gallery.querySelectorAll(".c-tile").forEach((t) => {
            const show = cat === "all" || t.dataset.category === cat;
            t.classList.toggle("is-hidden", !show);
          });
        }),
      );

      // Tabs + copy (same behaviour as the shared block)
      const block = document.querySelector("[data-source]");
      if (block) {
        const tabs = [...block.querySelectorAll("[data-tab]")];
        const panes = [...block.querySelectorAll("[data-code]")];
        const copyBtn = block.querySelector("[data-copy]");
        const select = (id) => {
          tabs.forEach((t) =>
            t.setAttribute("aria-selected", String(t.dataset.tab === id)),
          );
          panes.forEach((p) => (p.hidden = p.dataset.code !== id));
        };
        tabs.forEach((t) =>
          t.addEventListener("click", () => select(t.dataset.tab)),
        );
        copyBtn?.addEventListener("click", async () => {
          const active = panes.find((p) => !p.hidden);
          if (!active) return;
          await navigator.clipboard.writeText(active.textContent || "");
          copyBtn.textContent = "Copied!";
          setTimeout(() => (copyBtn.textContent = "Copy"), 1500);
        });
      }
    </script>
  </body>
</html>
