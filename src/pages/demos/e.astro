---
/*
 * Direction E — landing (ADR-0008). A no-sidebar marketing home of its own
 * design; the product sells itself. The docs/detail view (with the sidebar +
 * props controls) lives at /demos/e/detail. Self-contained shell. Throwaway.
 */
import "../../styles/global.css";
import "../../styles/demos.css";
import { catalog } from "../../components/demos/catalog";
import HomeNav from "../../components/demos/HomeNav.astro";

const pick = (name: string) => catalog.find((s) => s.name === name)!;
const featured = [
  pick("aurora"),
  pick("magnetic-button"),
  pick("tilt-card"),
  pick("glitch-text"),
  pick("orbit-loader"),
];
const detailHref = "/demos/e/detail";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Direction E — tskr/ui demo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-direction="e">
    <div class="e-shell">
      <HomeNav current="centered" />

      <div class="e-wrap">
        <!-- Hero -->
        <header class="e-hero">
          <span class="e-eyebrow">the copy-paste collection</span>
          <h1>Components you <em>own</em>, not install.</h1>
          <p>
            A growing collection of components, effects, and layouts for Vue,
            React, and plain HTML. Copy the source, paste it in, ship. No CLI, no
            package, no lock-in.
          </p>
          <div class="e-cta">
            <a class="d-btn d-btn--primary" href={detailHref}>Browse snippets</a>
            <a
              class="d-btn d-btn--ghost"
              href="https://github.com/lichingchester/vsap">GitHub</a
            >
          </div>
        </header>

        <!-- Featured -->
        <section class="e-section">
          <p class="e-section__label">Featured</p>
          <div class="e-feats">
            <a class="c-tile" href={detailHref} aria-label="Gradient Text">
              <div class="c-tile__art c-tile__art--live">
                <span class="d-gradient-text">Gradient Text</span>
              </div>
              <div class="c-tile__bar">
                <span class="c-tile__name">Gradient Text</span>
                <span class="c-tile__live">live</span>
              </div>
            </a>
            {
              featured.map((s, i) => (
                <a class="c-tile" href={detailHref} aria-label={s.title}>
                  <div class={"c-tile__art c-art-" + ((i + 1) % 6)} />
                  <div class="c-tile__bar">
                    <span class="c-tile__name">{s.title}</span>
                    <span class="c-tile__kind">{s.kind}</span>
                  </div>
                </a>
              ))
            }
          </div>
        </section>

        <!-- Value band -->
        <section class="e-section">
          <p class="e-section__label">Why tskr/ui</p>
          <div class="e-values">
            <div class="e-value">
              <span class="e-value__k">own it</span>
              <h2>Copy, don't install</h2>
              <p>
                The source lands in your repo. Edit it, keep it, no version churn
                and nothing to update.
              </p>
            </div>
            <div class="e-value">
              <span class="e-value__k">any stack</span>
              <h2>Vue · React · HTML</h2>
              <p>
                Pick your framework and styling. Tailwind or plain CSS — the
                snippet ships in the flavour you need.
              </p>
            </div>
            <div class="e-value">
              <span class="e-value__k">honest</span>
              <h2>Prerequisites, not magic</h2>
              <p>
                Each snippet states exactly what it needs before you paste. No
                hand-wavy "zero-config" promises.
              </p>
            </div>
          </div>
        </section>

        <!-- Closing CTA -->
        <section class="e-bigcta">
          <h2>{catalog.length} snippets and counting.</h2>
          <a class="d-btn d-btn--primary" href={detailHref}>Open the collection</a>
        </section>

        <footer class="e-foot">tskr/ui · Direction E (landing) demo</footer>
      </div>
    </div>
  </body>
</html>
