---
import Layout from "../layouts/Layout.astro";
import linkTagMeta from "../snippets/utils/link-tag/meta";

// Hand-listed for the scaffold. Next step: discover via import.meta.glob("../snippets/**/meta.ts").
const snippets = [linkTagMeta];
---

<Layout
  title="Copy-paste UI"
  description="A copy-paste collection of UI components, effects, and layouts for the web."
>
  <h1 class="text-3xl font-semibold tracking-tight">tskr/ui</h1>
  <p class="mt-3 max-w-2xl text-neutral-400">
    A copy-paste collection of components, effects, and layouts. No install, no
    CLI — copy the source straight into your project.
  </p>

  <h2
    class="mt-10 mb-4 text-sm font-medium tracking-wide text-neutral-500 uppercase"
  >
    Snippets
  </h2>
  <ul class="grid gap-3 sm:grid-cols-2">
    {
      snippets.map((s) => (
        <li>
          <a
            href={`/snippets/${s.category}/${s.name}`}
            class="block rounded-xl border border-neutral-800 p-4 transition-colors hover:border-neutral-600"
          >
            <span class="block font-medium">{s.title}</span>
            <span class="mt-1 block text-sm text-neutral-400">
              {s.kind} · {s.category}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
