---
/*
 * Home — Terminal · Masthead (ADR-0008). No sidebar: wordmark, tagline, CTA,
 * a mono stats row, "Why tskr/ui" as # comment lines, then a typographic index
 * of every snippet (discovered from disk via the registry).
 */
import Layout from "../layouts/Layout.astro";
import { allSnippets, groupedSnippets, snippetHref } from "../lib/snippets";

const groups = groupedSnippets();
const total = allSnippets.length;
const browseHref = allSnippets[0] ? snippetHref(allSnippets[0]) : "/";
---

<Layout
  title="Copy-paste UI"
  description="A copy-paste collection of components, effects, and layouts for the web."
>
  <nav class="s-nav">
    <a class="s-brand" href="/">tskr<span>/ui</span></a>
    <nav class="s-navlinks">
      <a href={browseHref}>Snippets</a>
      <a href="https://github.com/lichingchester/vsap">GitHub</a>
    </nav>
  </nav>

  <div class="home">
    <header class="home-head">
      <h1 class="home-word">tskr<span>/ui</span></h1>
      <p class="home-tag">
        A copy-paste collection of components, effects, and layouts. Pick one,
        copy the source, paste it in. No CLI, no package.
      </p>

      <div class="home-cta">
        <a class="s-btn s-btn--primary" href={browseHref}>Browse snippets</a>
        <a class="s-btn s-btn--ghost" href="https://github.com/lichingchester/vsap">GitHub</a>
      </div>

      <div class="home-stats">
        <span><b>{total}</b> snippets</span>
        <span><b>{groups.length}</b> categories</span>
        <span><b>vue · react · html</b></span>
        <span><b>tailwind / css</b></span>
      </div>

      <div class="home-why">
        <p><b># </b><strong>copy, don't install</strong> — the source lives in your repo, no version churn</p>
        <p><b># </b><strong>any stack</strong> — Vue, React, or plain HTML; Tailwind or native CSS</p>
        <p><b># </b><strong>prerequisites, not magic</strong> — each snippet states exactly what it needs</p>
      </div>
    </header>

    <div class="home-index">
      {
        groups.map((g) => (
          <section>
            <p class="home-cat">{g.category}</p>
            {g.items.map((s) => (
              <a class="home-item" href={snippetHref(s)}>
                <span class="home-item__path">
                  <em>{s.category}/</em>
                  {s.name}
                </span>
                <span class="home-item__kind">{s.kind}</span>
              </a>
            ))}
          </section>
        ))
      }
    </div>
  </div>
</Layout>
