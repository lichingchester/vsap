---
import Layout from "../../../layouts/Layout.astro";
import meta from "../../../snippets/utils/link-tag/meta";
import SnippetTabs from "../../../components/SnippetTabs.vue";
// The reference variant, mounted as a real island for the live preview.
import LinkTag from "../../../snippets/utils/link-tag/vue/LinkTag.vue";

// No-drift rule (ADR-0004): the copy/code payload is read with ?raw from the
// SAME files — the Vue one here is the exact file mounted above for the preview.
// The other variants are only read as raw text, never executed, so their
// `next/link` / `#components` imports never need resolving.
import vueSrc from "../../../snippets/utils/link-tag/vue/LinkTag.vue?raw";
import nuxtSrc from "../../../snippets/utils/link-tag/vue-nuxt/LinkTag.vue?raw";
import reactSrc from "../../../snippets/utils/link-tag/react-next/LinkTag.tsx?raw";
import htmlSrc from "../../../snippets/utils/link-tag/html/link-tag.html?raw";

const codeById: Record<string, string> = {
  vue: vueSrc,
  "vue-nuxt": nuxtSrc,
  "react-next": reactSrc,
  html: htmlSrc,
};

const variants = meta.variants.map((v) => ({
  id: v.id,
  label: v.label,
  native: v.native,
  reference: v.reference,
  prerequisites: v.prerequisites,
  code: codeById[v.id] ?? "",
}));
---

<Layout title={meta.title} description={meta.description}>
  <p class="text-xs tracking-wide text-neutral-500 uppercase">
    {meta.kind} · {meta.category}
  </p>
  <h1 class="mt-1 text-3xl font-semibold tracking-tight">{meta.title}</h1>
  <p class="mt-3 max-w-2xl text-neutral-400">{meta.description}</p>

  {/* Live preview: the Vue reference variant as a real island. Rendered with
      `external` so it shows a plain <a> and needs no router instance. */}
  <section
    class="mt-8 flex min-h-32 items-center justify-center rounded-xl border border-neutral-800 bg-neutral-900"
  >
    <LinkTag
      client:load
      href="https://example.com"
      external={true}
      newTab={true}
      attributes={{
        class: "text-lg underline underline-offset-4 hover:text-neutral-300",
      }}
    >
      Visit example.com →
    </LinkTag>
  </section>

  <h2
    class="mt-10 mb-3 text-sm font-medium tracking-wide text-neutral-500 uppercase"
  >
    Source
  </h2>
  <SnippetTabs client:load variants={variants} />
</Layout>
