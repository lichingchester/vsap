---
import Layout from "../../../layouts/Layout.astro";
import meta from "../../../snippets/text-animations/gradient-text/meta";
import SnippetTabs from "../../../components/SnippetTabs.vue";
// The playground is this flagship snippet's live preview (ADR-0007). It mounts
// the Vue+Tailwind reference variant internally — the same file ?raw-imported
// below for the code tab (no-drift, ADR-0004).
import GradientTextPlayground from "../../../components/GradientTextPlayground.vue";

// No-drift rule: every code tab is read with ?raw from the SAME variant files.
// The reference (vue-tailwind) is the one the playground actually runs; the
// other cells are raw text only, never executed, so their imports never resolve.
import vueTwSrc from "../../../snippets/text-animations/gradient-text/vue-tailwind/GradientText.vue?raw";
import vueCssSrc from "../../../snippets/text-animations/gradient-text/vue-css/GradientText.vue?raw";
import reactTwSrc from "../../../snippets/text-animations/gradient-text/react-tailwind/GradientText.tsx?raw";
import reactCssSrc from "../../../snippets/text-animations/gradient-text/react-css/GradientText.tsx?raw";
import reactCssStyleSrc from "../../../snippets/text-animations/gradient-text/react-css/GradientText.css?raw";
import htmlSrc from "../../../snippets/text-animations/gradient-text/html/gradient-text.html?raw";

// react-css ships two files; show the component plus its companion stylesheet.
const reactCssCombined = `${reactCssSrc}\n\n/* GradientText.css */\n${reactCssStyleSrc}`;

const codeById: Record<string, string> = {
  "vue-tailwind": vueTwSrc,
  "vue-css": vueCssSrc,
  "react-tailwind": reactTwSrc,
  "react-css": reactCssCombined,
  html: htmlSrc,
};

const variants = meta.variants.map((v) => ({
  id: v.id,
  label: v.label,
  native: v.native,
  reference: v.reference,
  prerequisites: v.prerequisites,
  code: codeById[v.id] ?? "",
}));
---

<Layout title={meta.title} description={meta.description}>
  <p class="text-xs tracking-wide text-neutral-500 uppercase">
    {meta.kind} · {meta.category}
  </p>
  <h1 class="mt-1 text-3xl font-semibold tracking-tight">{meta.title}</h1>
  <p class="mt-3 max-w-2xl text-neutral-400">{meta.description}</p>

  {/* Flagship playground = the live preview (ADR-0007). One island, running
      the reference variant with live color / direction / loop controls. */}
  <section class="mt-8">
    <GradientTextPlayground client:load />
  </section>

  <h2
    class="mt-10 mb-3 text-sm font-medium tracking-wide text-neutral-500 uppercase"
  >
    Source
  </h2>
  <SnippetTabs client:load variants={variants} />
</Layout>
