---
/*
 * THROWAWAY (detail-page /demos harness). The docs shell for the detail-page
 * layout demos — mirrors the real SnippetLayout (header + name-only mono sidebar
 * + main) so candidates are judged in context (ADR-0008), but adds the GLOBAL
 * variant selector in the header (the persisted preference, set once, honoured
 * everywhere). Deleted on promotion.
 */
import Layout from "./Layout.astro";
import { groupedSnippets, snippetHref } from "../lib/snippets";
import VariantSelector from "../demos/VariantSelector.vue";
import "../styles/demos-detail.css";

interface Props {
  title: string;
  active: string;
}
const { title, active } = Astro.props;
const groups = groupedSnippets();
---

<Layout title={`${title} — demo`}>
  <div class="docs-app">
    <header class="docs-header">
      <a class="s-brand" href="/demos">tskr<span>/ui</span></a>
      <div style="display:flex; align-items:center; gap:1.25rem;">
        <VariantSelector compact client:load />
        <nav class="s-navlinks">
          <a href="/demos">Demos</a>
          <a href="/">Site</a>
        </nav>
      </div>
    </header>

    <div class="docs-body">
      <aside class="docs-side" aria-label="Snippets">
        {
          groups.map((g) => (
            <div class="docs-side__group">
              <p class="docs-side__cat">{g.category}</p>
              {g.items.map((s) => (
                <a
                  class="docs-link"
                  href={snippetHref(s)}
                  aria-current={s.name === active ? "true" : "false"}
                >
                  {s.name}
                </a>
              ))}
            </div>
          ))
        }
      </aside>

      <main class="docs-main">
        <div class="docs-wrap">
          <slot />
        </div>
      </main>
    </div>
  </div>
</Layout>
