---
/*
 * SnippetLayout — the docs shell for snippet detail pages (ADR-0008):
 * full-width header, a left sidebar listing every snippet (name only, mono),
 * and a contained main column. The page supplies the detail content + its own
 * right-hand "On this page" TOC.
 */
import Layout from "./Layout.astro";
import { groupedSnippets, snippetHref } from "../lib/snippets";
import VariantSelector from "../detail/VariantSelector.vue";
import Brand from "../components/Brand.astro";
import NavActions from "../components/NavActions.astro";
import "../styles/detail.css";

interface Props {
  title: string;
  description?: string;
  /** name of the active snippet, for sidebar highlighting */
  active: string;
}
const { title, description, active } = Astro.props;
const groups = groupedSnippets();
---

<Layout title={title} description={description}>
  <div class="docs-app">
    <header class="docs-header">
      <Brand />
      <div class="docs-header__right">
        <VariantSelector compact client:load />
        <nav class="s-navlinks">
          <NavActions />
        </nav>
      </div>
    </header>

    <div class="docs-body">
      <aside class="docs-side" aria-label="Snippets">
        {
          groups.map((g) => (
            <div class="docs-side__group">
              <p class="docs-side__cat">{g.category}</p>
              {g.items.map((s) => (
                <a
                  class="docs-link"
                  href={snippetHref(s)}
                  aria-current={s.name === active ? "true" : "false"}
                >
                  {s.name}
                </a>
              ))}
            </div>
          ))
        }
      </aside>

      <main class="docs-main">
        <div class="docs-wrap">
          <slot />
        </div>
      </main>
    </div>
  </div>
</Layout>
