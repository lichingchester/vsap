---
/*
 * Base layout — html/head/fonts/body shell shared by every page. Page chrome
 * (the home masthead, the docs sidebar) is composed by the pages/SnippetLayout
 * on top of this. Applies the design system (global.css + site.css).
 */
import "../styles/global.css";
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const pageTitle = `${title} — tskr/ui`;
const metaDescription =
  description ??
  "A copy-paste collection of components, effects, and layouts for the web.";
// Absolute URLs for the canonical link + social cards. Astro.site is set in
// astro.config.mjs (https://ui.tskrlabs.com); new URL() joins it with the path.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Theme (ADR-0016): resolve before first paint so a light-preferring
        visitor never flashes dark. Defaults to the OS setting until the visitor
        makes an explicit choice (stored under `tskr-theme`). */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("tskr-theme"); // 'light' | 'dark' | null
          const theme =
            stored ??
            (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
          const m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute("content", theme === "light" ? "#fbfaf7" : "#0e0e11");
        } catch {}
      })();
    </script>
    <meta name="theme-color" content="#0e0e11" />

    {/* Google Analytics (GA4) — production only, so local dev traffic doesn't
        pollute reports. `is:inline` keeps the tags verbatim (unbundled). */}
    {
      import.meta.env.PROD && (
        <>
          <script
            is:inline
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-SEV45BE0K5"
          />
          <script is:inline>
            {`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', 'G-SEV45BE0K5');
            `}
          </script>
        </>
      )
    }

    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph / Twitter — social link previews. Absolute URLs via `site`. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tskr/ui" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="s-root">
    <slot />
  </body>
</html>
